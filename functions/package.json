{
  "name": "nzsurf-functions",
  "description": "NzSurf server-monitoring: mailt een agenda-uitnodiging bij topdagen (score >= 7.0)",
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "sync-logic": "bash ../scripts/sync-functions-logic.sh",
    "deploy": "npm run sync-logic && firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.1.0",
    "nodemailer": "^6.9.15"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.16",
    "typescript": "~5.8.2"
  },
  "private": true
}
